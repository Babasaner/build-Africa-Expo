<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteCond %{REQUEST_URI} !(\.map|\.json)$
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # --- 1. GESTION DU CACHE (Cache-Busting automatique) ---
  
  # NE JAMAIS mettre en cache index.html
  # Ainsi, à chaque visite/rafraîchissement, le navigateur vérifie s'il y a une nouvelle version du site.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Mettre en cache indéfiniment les assets générés par Vite (qui ont un hash unique ex: main.12345.js)
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot|png|jpg|jpeg|gif|ico|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- 2. SÉCURITÉ ---
  
  # Empêcher le navigateur de deviner le type MIME (protection contre le sniffing)
  Header set X-Content-Type-Options "nosniff"
  
  # Empêcher le site d'être chargé dans un iframe d'un autre site (protection Clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Activer le filtre XSS natif du navigateur
  Header set X-XSS-Protection "1; mode=block"
  
  # Forcer l'utilisation de HTTPS
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Ne pas envoyer l'URL complète comme referrer aux sites externes pour des raisons de confidentialité
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
