# Configuration Google Analytics
# Remplacer G-XXXXXXXXXX par votre propre ID de suivi (Measurement ID)
# L'application Vite charge automatiquement les variables commençant par VITE_
VITE_GA_TRACKING_ID=G-R895BRK3NW

# Clés d'accès Web3Forms pour chaque formulaire
VITE_WEB3FORMS_CONTACT_KEY=votre_cle_page_contact
VITE_WEB3FORMS_VISITEUR_KEY=votre_cle_page_visiteur
VITE_WEB3FORMS_PARTENAIRE_KEY=votre_cle_page_partenaire
